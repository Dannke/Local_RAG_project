# Never bundle secrets or local state into the Docker image
.env
.env.*
!.env.example

# Local state that must not enter the image
data/
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/vector_store/.gitkeep
!data/chats/.gitkeep

# VCS / IDE / caches
.git
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs / temp
logs/
tmp/
streamlit.*.log
audit.md
