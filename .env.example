RAG_PROJECT_ROOT=.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_LLM_MODEL=openrouter/auto
# Chunk size/overlap are measured in TOKENS of the embedding model's tokenizer
# (not characters), so the chunk boundary matches what the model actually sees.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

HF_TOKEN=hf_your-huggingface-token

TOP_K=5
MAX_CONTEXT_CHARS=12000
TEMPERATURE=0.2

USE_RERANKER=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20

# Rate limiting for LLM requests (0 = disabled, or e.g. 5 requests / 60s per session)
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
